# ╔══════════════════════════════════════════════════════════════╗
# ║        SocialSphere — AWS EC2 Environment Configuration      ║
# ║  Replace YOUR_EC2_PUBLIC_IP with your actual EC2 IP/Domain  ║
# ╚══════════════════════════════════════════════════════════════╝

# ─────────────────────────────────────────────
# PLATFORM MODE
# ─────────────────────────────────────────────
# "true"  = Training Mode (intentionally vulnerable)
# "false" = Secure Mode   (hardened, production-like)
TRAINING_MODE=true

NODE_ENV=production

# ─────────────────────────────────────────────
# EC2 PUBLIC HOST / IP CONFIGURATION
# Replace with your EC2 Elastic IP or Public IPv4 (e.g., 54.210.12.34)
# ─────────────────────────────────────────────
PUBLIC_IP=YOUR_EC2_PUBLIC_IP
NEXT_PUBLIC_API_URL=http://YOUR_EC2_PUBLIC_IP/api
NEXT_PUBLIC_WS_URL=ws://YOUR_EC2_PUBLIC_IP
NEXT_PUBLIC_MODE=training

# ─────────────────────────────────────────────
# BACKEND
# ─────────────────────────────────────────────
PORT=4000
HOST=0.0.0.0

# ─────────────────────────────────────────────
# DATABASE — PostgreSQL (Docker container)
# ─────────────────────────────────────────────
DATABASE_URL=postgresql://socialsphere:socialsphere_secure_pass_2024@postgres:5432/socialsphere
DB_HOST=postgres
DB_PORT=5432
DB_NAME=socialsphere
DB_USER=socialsphere
DB_PASSWORD=socialsphere_secure_pass_2024
DB_SSL=false

# ─────────────────────────────────────────────
# CACHE — Redis (Docker container)
# ─────────────────────────────────────────────
REDIS_URL=redis://redis:6379
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ─────────────────────────────────────────────
# OBJECT STORAGE — MinIO
# ─────────────────────────────────────────────
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin_secure_pass
MINIO_BUCKET=socialsphere

# ─────────────────────────────────────────────
# AUTHENTICATION — JWT
# ─────────────────────────────────────────────
JWT_SECRET=super_weak_secret_for_training_do_not_use_in_production
JWT_REFRESH_SECRET=another_weak_secret_training_only
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ALGORITHM=HS256

SESSION_SECRET=weak_session_secret_training_only
SESSION_NAME=ss_session

# ─────────────────────────────────────────────
# EMAIL — SMTP (MailHog)
# ─────────────────────────────────────────────
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM=noreply@socialsphere.local

# ─────────────────────────────────────────────
# CORS & SECURITY SETTINGS
# ─────────────────────────────────────────────
CORS_ORIGINS=http://YOUR_EC2_PUBLIC_IP,http://YOUR_EC2_PUBLIC_IP:3000
ALLOW_ALL_CORS=true
DISABLE_RATE_LIMIT=true
SHOW_STACK_TRACES=true
DISABLE_CSRF=true
DISABLE_SECURITY_HEADERS=true
DISABLE_CSP=true

# ─────────────────────────────────────────────
# CTF / LAB MODE
# ─────────────────────────────────────────────
CTF_MODE=true
CTF_SECRET=socialsphere_ctf_2024
SHOW_HINTS=true
